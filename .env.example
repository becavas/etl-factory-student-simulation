# Plantilla de configuración local no sensible.
# Copiar a .env.local solo cuando una fase declare una variable local.
# Nunca escribir tokens, passwords ni client secrets en este archivo.

BUNDLE_VAR_catalog=<catalogo_asignado>
BUNDLE_VAR_source_volume_path=/Volumes/<catalogo_asignado>/landing/pedidos_source
BUNDLE_VAR_policy_id=<policy-id-aprobado>
BUNDLE_VAR_node_type_id=<node-type-aprobado>
