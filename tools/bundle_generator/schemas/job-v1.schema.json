{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-fabric.local/schemas/bundle-job-v1.schema.json",
  "title": "Enterprise Fabric Bundle Jobs v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "kind", "metadata", "package", "jobs"],
  "properties": {
    "spec_version": {"const": 1},
    "kind": {"const": "bundle_jobs"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "package": {"$ref": "#/$defs/package"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "capability"],
      "properties": {
        "domain": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/identifier"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "wheel_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "wheel_path": {"type": "string", "minLength": 1}
      }
    },
    "scalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "string_map": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
      "additionalProperties": {"type": "string"}
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "profile", "tags"],
      "properties": {
        "key": {"$ref": "#/$defs/identifier"},
        "profile": {"enum": ["classic_single_user_small"]},
        "tags": {"$ref": "#/$defs/string_map"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "min_retry_interval_millis": {"type": "integer", "minimum": 0},
        "retry_on_timeout": {"type": "boolean"}
      }
    },
    "wheel_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point", "named_parameters"],
      "properties": {
        "entry_point": {"type": "string", "minLength": 1},
        "named_parameters": {"$ref": "#/$defs/string_map"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "cluster_key",
        "timeout_seconds",
        "retry",
        "wheel"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/identifier"},
        "cluster_key": {"$ref": "#/$defs/identifier"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "retry": {"$ref": "#/$defs/retry"},
        "wheel": {"$ref": "#/$defs/wheel_task"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "layer",
        "max_concurrent_runs",
        "parameters",
        "clusters",
        "tasks"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "layer": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "max_concurrent_runs": {"type": "integer", "minimum": 1},
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        },
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/cluster"}
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    }
  }
}
